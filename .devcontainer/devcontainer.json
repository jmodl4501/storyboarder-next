{
  "name": "Storyboarder Next",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Storyboarder Next", "onAutoForward": "openPreview", "visibility": "private" }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "bash .devcontainer/start.sh",
  "remoteEnv": { "HOST": "0.0.0.0", "PORT": "3000" }
}
