# ---- 서버 ----
PORT=3000
HOST=0.0.0.0
# 프로젝트 저장 위치 (기본: ./projects)
# PROJECTS_DIR=/path/to/projects

# 외부(AI 서비스)에서 보드 이미지를 가져갈 수 있는 공개 URL (예: cloudflared / ngrok 터널)
# Higgsfield 등 image_url 을 요구하는 API 에 필요합니다.
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# ---- 텍스트 AI (OpenAI 호환: OpenAI / OpenRouter / Ollama / LM Studio 등) ----
# AI_TEXT_BASE_URL=https://api.openai.com/v1
# AI_TEXT_API_KEY=sk-...
# AI_TEXT_MODEL=gpt-4o-mini

# 장면 설명용 비전 모델 (기본: AI_TEXT_MODEL). 이미지 입력을 받는 OpenAI 호환 모델이어야 합니다 (gpt-4o-mini, llava, qwen2-vl …)
# AI_VISION_MODEL=gpt-4o-mini

# ---- 영상 → 장면별 스토리보드 (v0.3) ----
# yt-dlp / ffmpeg 가 PATH 에 없을 때 경로 지정 (둘 다 선택 사항: 없으면 직접 영상 URL 과 로컬 파일 드롭만 지원)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# 서버가 가져오거나 업로드받는 영상 한 편의 최대 크기 (MB, 기본 1024)
# VIDEO_MAX_MB=1024
# 가져온 영상의 임시 캐시 폴더 (기본: OS 임시 폴더/storyboarder-next-video, 6시간 뒤 자동 삭제)
# VIDEO_CACHE_DIR=/var/tmp/sbn-video
# 사설 IP(LAN) 주소의 영상도 가져오게 허용 (기본 차단, 테스트/사내망용)
# VIDEO_FETCH_ALLOW_PRIVATE=1

# ---- Higgsfield (영상 생성) : https://console.higgsfield.ai 에서 발급 ----
# HF_API_KEY_ID=...
# HF_API_KEY_SECRET=...
# HF_ENDPOINT=kling-video/v3.0/std/image-to-video

# 링크 미리보기에서 외부 네트워크 접근을 막고 싶을 때 (썸네일 URL 규칙만 사용)
# LINK_PREVIEW_OFFLINE=1
