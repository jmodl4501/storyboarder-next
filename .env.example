# ---- 서버 ----
PORT=3000
HOST=0.0.0.0
# 프로젝트 저장 위치 (기본: ./projects)
# PROJECTS_DIR=/path/to/projects

# 외부(AI 서비스)에서 보드 이미지를 가져갈 수 있는 공개 URL (예: cloudflared / ngrok 터널)
# Higgsfield 등 image_url 을 요구하는 API 에 필요합니다.
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# ---- 텍스트 AI (OpenAI 호환: OpenAI / OpenRouter / Ollama / LM Studio 등) ----
# AI_TEXT_BASE_URL=https://api.openai.com/v1
# AI_TEXT_API_KEY=sk-...
# AI_TEXT_MODEL=gpt-4o-mini

# ---- Higgsfield (영상 생성) : https://console.higgsfield.ai 에서 발급 ----
# HF_API_KEY_ID=...
# HF_API_KEY_SECRET=...
# HF_ENDPOINT=kling-video/v3.0/std/image-to-video

# 링크 미리보기에서 외부 네트워크 접근을 막고 싶을 때 (썸네일 URL 규칙만 사용)
# LINK_PREVIEW_OFFLINE=1
